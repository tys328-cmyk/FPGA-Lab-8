`timescale 1ns / 1ps
module sequential_multiplier (
    input wire clk,
    input wire reset,
    input wire start,
    input wire [3:0] a,
    input wire [3:0] b,
    output reg [7:0] product,
    output reg busy,
    output reg done
);
    reg [7:0] multiplicand;
    reg [3:0] multiplier;
    reg [2:0] count;

    always @(posedge clk) begin
        if (reset) begin
            product <= 8'd0;
            multiplicand <= 8'd0;
            multiplier <= 4'd0;
            count <= 3'd0;
            busy <= 1'b0;
            done <= 1'b0;
        end else if (!busy) begin
            if (start) begin
                multiplicand <= {4'b0000, a};
                multiplier <= b;
                product <= 8'd0;
                count <= 3'd0;
                busy <= 1'b1;
                done <= 1'b0;
            end
        end else begin
            if (multiplier[0])
                product <= product + multiplicand;
            multiplicand <= multiplicand << 1;
            multiplier <= multiplier >> 1;
            count <= count + 1'b1;
            if (count == 3'd3) begin
                busy <= 1'b0;
                done <= 1'b1;
            end
        end
    end
endmodule


