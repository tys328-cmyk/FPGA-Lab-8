`timescale 1ns / 1ps
module tb_sequential_multiplier;
    reg clk = 0, reset = 1, start = 0;
    reg [3:0] a = 0, b = 0;
    wire [7:0] product;
    wire busy, done;
    integer i, j;
    always #5 clk = ~clk;
    sequential_multiplier dut (
        .clk(clk), .reset(reset), .start(start), .a(a), .b(b),
        .product(product), .busy(busy), .done(done)
    );
    initial begin
        repeat (2) @(negedge clk);
        reset = 0;
        for (i = 0; i < 16; i = i + 1) begin
            for (j = 0; j < 16; j = j + 1) begin
                @(negedge clk);
                a = i; b = j; start = 1;
                @(negedge clk);
                start = 0;
                wait(done === 1'b1);
                #1;
                if (product !== (i*j)) $fatal(1,"FAIL %0d*%0d=%0d",i,j,product);
            end
        end
        $display("PASS: All 256 sequential cases");
        $finish;
    end
    initial begin
        #100000;
        $fatal(1, "Timeout");
    end
endmodule


